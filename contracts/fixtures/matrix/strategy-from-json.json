{
  "description": "a whole strategy computed by an expression gives the matrix, fail-fast and max-parallel",
  "outputs": {
    "strategy": "{\"fail-fast\": false, \"max-parallel\": 1, \"matrix\": {\"shard\": [1, 2]}}"
  },
  "strategy": "${{ fromJSON(needs.setup.outputs.strategy) }}",
  "jobs": [
    {
      "name": "test (1)",
      "matrix": {
        "shard": 1
      },
      "strategy": {
        "fail-fast": false,
        "job-index": 0,
        "job-total": 2,
        "max-parallel": 1
      }
    },
    {
      "name": "test (2)",
      "matrix": {
        "shard": 2
      },
      "strategy": {
        "fail-fast": false,
        "job-index": 1,
        "job-total": 2,
        "max-parallel": 1
      }
    }
  ]
}
