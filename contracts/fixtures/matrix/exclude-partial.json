{
  "description": "an exclude entry removes every combination it matches, even when it names only some of the vectors",
  "strategy": {
    "matrix": {
      "os": [
        "macos-latest",
        "windows-latest"
      ],
      "version": [
        12,
        14,
        16
      ],
      "environment": [
        "staging",
        "production"
      ],
      "exclude": [
        {
          "os": "macos-latest",
          "version": 12,
          "environment": "production"
        },
        {
          "os": "windows-latest",
          "version": 16
        }
      ]
    }
  },
  "jobs": [
    {
      "name": "test (macos-latest, 12, staging)",
      "matrix": {
        "os": "macos-latest",
        "version": 12,
        "environment": "staging"
      },
      "strategy": {
        "fail-fast": true,
        "job-index": 0,
        "job-total": 9,
        "max-parallel": 9
      }
    },
    {
      "name": "test (macos-latest, 14, staging)",
      "matrix": {
        "os": "macos-latest",
        "version": 14,
        "environment": "staging"
      },
      "strategy": {
        "fail-fast": true,
        "job-index": 1,
        "job-total": 9,
        "max-parallel": 9
      }
    },
    {
      "name": "test (macos-latest, 14, production)",
      "matrix": {
        "os": "macos-latest",
        "version": 14,
        "environment": "production"
      },
      "strategy": {
        "fail-fast": true,
        "job-index": 2,
        "job-total": 9,
        "max-parallel": 9
      }
    },
    {
      "name": "test (macos-latest, 16, staging)",
      "matrix": {
        "os": "macos-latest",
        "version": 16,
        "environment": "staging"
      },
      "strategy": {
        "fail-fast": true,
        "job-index": 3,
        "job-total": 9,
        "max-parallel": 9
      }
    },
    {
      "name": "test (macos-latest, 16, production)",
      "matrix": {
        "os": "macos-latest",
        "version": 16,
        "environment": "production"
      },
      "strategy": {
        "fail-fast": true,
        "job-index": 4,
        "job-total": 9,
        "max-parallel": 9
      }
    },
    {
      "name": "test (windows-latest, 12, staging)",
      "matrix": {
        "os": "windows-latest",
        "version": 12,
        "environment": "staging"
      },
      "strategy": {
        "fail-fast": true,
        "job-index": 5,
        "job-total": 9,
        "max-parallel": 9
      }
    },
    {
      "name": "test (windows-latest, 12, production)",
      "matrix": {
        "os": "windows-latest",
        "version": 12,
        "environment": "production"
      },
      "strategy": {
        "fail-fast": true,
        "job-index": 6,
        "job-total": 9,
        "max-parallel": 9
      }
    },
    {
      "name": "test (windows-latest, 14, staging)",
      "matrix": {
        "os": "windows-latest",
        "version": 14,
        "environment": "staging"
      },
      "strategy": {
        "fail-fast": true,
        "job-index": 7,
        "job-total": 9,
        "max-parallel": 9
      }
    },
    {
      "name": "test (windows-latest, 14, production)",
      "matrix": {
        "os": "windows-latest",
        "version": 14,
        "environment": "production"
      },
      "strategy": {
        "fail-fast": true,
        "job-index": 8,
        "job-total": 9,
        "max-parallel": 9
      }
    }
  ]
}
