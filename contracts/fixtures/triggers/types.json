      "create": null
    },
    "event": {
      "name": "create"
    },
    "matches": true
  },
  {
    "description": "repository_dispatch with types runs for a listed event type",
    "on": {
      "repository_dispatch": {
        "types": ["deploy"]
      }
    },
    "event": {
      "name": "repository_dispatch",
      "action": "deploy"
    },
    "matches": true
  },
  {
