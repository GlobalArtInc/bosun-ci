    "on": {
      "pull_request": {
        "types": ["closed"]
      }
    },
    "event": {
      "name": "pull_request",
      "action": "closed",
      "base_ref": "refs/heads/main"
    },
    "matches": true
  },
  {
    "description": "pull_request with types does not run for a default type it does not list",
    "on": {
      "pull_request": {
        "types": ["closed"]
      }
    },
    "event": {
      "name": "pull_request",
      "action": "opened",
      "base_ref": "refs/heads/main"
    },
    "matches": false
  },
  {
    "description": "pull_request_target without types runs for `opened`",
    "on": {
      "pull_request_target": null
    },
    "event": {
      "name": "pull_request_target",
      "action": "opened",
      "base_ref": "refs/heads/main"
    },
    "matches": true
  },
  {
    "description": "pull_request_target without types does not run for `closed`",
    "on": {
      "pull_request_target": null
    },
    "event": {
      "name": "pull_request_target",
      "action": "closed",
      "base_ref": "refs/heads/main"
    },
    "matches": false
  },
  {
    "description": "issues with types runs for a listed type",
    "on": {
      "issues": {
        "types": ["opened"]
      }
    },
    "event": {
      "name": "issues",
      "action": "opened"
    },
    "matches": true
  },
  {
    "description": "issues with types does not run for another type",
    "on": {
      "issues": {
        "types": ["opened"]
      }
    },
    "event": {
      "name": "issues",
      "action": "closed"
    },
    "matches": false
  },
  {
    "description": "issues with types does not run for an event without an action",
    "on": {
      "issues": {
        "types": ["opened"]
      }
    },
    "event": {
      "name": "issues"
    },
    "matches": false
  },
  {
    "description": "release without types runs for every type",
