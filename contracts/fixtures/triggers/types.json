[
  {
    "description": "pull_request without types runs for `opened`",
    "on": {
      "pull_request": null
    },
    "event": {
      "name": "pull_request",
      "action": "opened",
      "base_ref": "refs/heads/main"
    },
    "matches": true
  },
  {
    "description": "pull_request without types runs for `synchronize`",
    "on": {
      "pull_request": null
    },
    "event": {
      "name": "pull_request",
      "action": "synchronize",
      "base_ref": "refs/heads/main"
    },
    "matches": true
  },
  {
    "description": "pull_request without types runs for `reopened`",
    "on": {
      "pull_request": null
    },
    "event": {
      "name": "pull_request",
      "action": "reopened",
      "base_ref": "refs/heads/main"
    },
    "matches": true
  },
  {
    "description": "pull_request without types does not run for `closed`",
